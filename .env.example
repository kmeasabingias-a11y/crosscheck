# CrossCheck configuration — copy this file to `.env` and fill in the values.
# `.env` is gitignored; never commit real keys.
#
#   cp .env.example .env
#
# Every CROSSCHECK_* variable maps to a field on the Settings panel (config.py).
# The two API keys use their provider-standard names (no prefix) so existing
# shell exports work as-is.

# --- LLM provider keys (used from Phase 1; leave blank until then) ---
# Judge model runs on Claude (Anthropic). The cross-model benchmark generator
# and cross-judge run on GPT (OpenAI) — spec v2 §9.1.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- App basics ---
CROSSCHECK_ENVIRONMENT=dev
CROSSCHECK_LOG_LEVEL=INFO

# --- Cost ceiling (spec v2 §4 — mandatory circuit breaker) ---
# Hard cap on total LLM spend per audit. When hit, the audit stops dispatching
# new judge calls, finalizes what it has, and marks the report partial.
CROSSCHECK_MAX_AUDIT_COST_USD=5.00
# Per-document cap within a single audit.
CROSSCHECK_MAX_DOCUMENT_COST_USD=0.50

# --- Models (Phase 1) ---
CROSSCHECK_JUDGE_MODEL=claude-sonnet-4-6
CROSSCHECK_EXTRACTION_MODEL=claude-sonnet-4-6

# --- LLM call tuning (Phase 1) ---
CROSSCHECK_LLM_MAX_TOKENS=2048
CROSSCHECK_LLM_TIMEOUT_SECONDS=60
CROSSCHECK_LLM_MAX_RETRIES=2